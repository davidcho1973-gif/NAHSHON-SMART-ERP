APP_NAME="SMART COMPANY"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ko
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nahshon_smart_erp
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# AI 통합 문서함 원본 파일 저장소.
# 비워 두는 것이 안전하다 — 버킷(AWS_BUCKET)이 붙으면 자동으로 s3 를 쓴다.
# 여기에 local 을 박아 두면 배포마다 원본이 사라진다(Laravel Cloud 로컬 디스크는 임시).
DOCUMENT_STORAGE_DISK=
DOCUMENT_AI_NATIVE_MAX_BYTES=15728640
QUEUE_CONNECTION=database

# 캐시는 파일에 둔다. 데이터베이스에 두면 schedule:run 이 매분 "스케줄러가 멈춰 있나"를
# 캐시에서 확인하느라 데이터베이스를 깨워, 서버리스 데이터베이스가 영영 잠들지 못한다.
# 공유가 필요한 것(세션·큐)은 그대로 데이터베이스를 쓴다.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development keeps email in logs. Production must use a real SMTP provider.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Cloud production example:
# ── 실제 발송 (Microsoft 365 / Graph API) ─────────────────────────
# 이 회사는 M365 를 쓴다. SMTP 아이디·비밀번호 방식은 마이크로소프트가 폐지하는 중이라
# (2026-04-30 부터 일부 거절, 2026-12 말 기본 비활성화) 새로 붙이지 않는다.
# Graph 는 OAuth 라 만료되는 비밀번호가 없고, DNS 를 하나도 안 건드린다.
# 자세한 절차는 MAIL_SETUP.md 참고.
#
# MAIL_MAILER=graph
# MAIL_FROM_ADDRESS=erp@your-domain.com
# MAIL_FROM_NAME="회사 이름"
# GRAPH_MAIL_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GRAPH_MAIL_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GRAPH_MAIL_CLIENT_SECRET=   ← Entra 의 «값(Value)» 칸. «비밀 ID» 가 아니다(흔한 실수)
# GRAPH_MAIL_SENDER=erp@your-domain.com   ← MAIL_FROM_ADDRESS 와 반드시 같아야 한다
#
# Graph 를 쓰면 아래 SMTP 값들은 <b>읽지도 않는다.</b> 전부 비워 둔다.
#
# ⚠ MAIL_SCHEME 에 tls 를 넣지 말 것.
#   Symfony 가 받는 값은 smtp / smtps 두 개뿐이라, tls 를 넣으면 설정 점검은 초록불인데
#   발송만 예외로 죽는다(값이 다 채워져 있어 점검을 통과한다). 587 포트면 비워 두는 것이 정답.
#   이 파일이 예전에 tls 를 권하고 있었고, 그것 때문에 실제로 하루를 잃었다.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SMART_COMPANY_ADMIN_NAME="David Cho"
SMART_COMPANY_ADMIN_EMAIL=davidcho1973@gmail.com
SMART_COMPANY_ADMIN_PASSWORD="1234"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
GOOGLE_AUTH_PROMPT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=30

# Kakao Alimtalk: provision channel and approved templates first. Never enable on staging.
KAKAO_REMINDERS_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_KAKAO_CHANNEL_ID=
KAKAO_APP_URL=
# Set 1 only after provider confirms US Alimtalk for this account.
KAKAO_CONFIRMED_COUNTRIES=
KAKAO_TEMPLATE_CLOCK_IN=
KAKAO_TEMPLATE_CLOCK_OUT=
KAKAO_TEMPLATE_DAILY_REPORT=
